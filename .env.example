SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
OPENAI_API_KEY=sk-your-openai-key

RON_DB_PATH=/data/ron.sqlite
RON_MODEL=gpt-4o-mini
RON_MAX_REQ_PER_HOUR=30
RON_COOLDOWN_MS=15000
RON_MAX_OUTPUT_TOKENS=160

# Daily affirmations (optional — leave RON_AFFIRMATION_CHANNEL unset to disable)
# RON_AFFIRMATION_CHANNEL=#general
RON_AFFIRMATION_CRON=0 9 * * *
